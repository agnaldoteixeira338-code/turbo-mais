# =============================================================================
# Turbo Mais — API e Worker
# Copie para .env (desenvolvimento local fora do Docker). NUNCA commite o .env.
# Gere segredos com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================

NODE_ENV=development
PORT=3333
WORKER_HEALTH_PORT=3334
LOG_LEVEL=info
# Nº de proxies confiáveis à frente da API (Render = 1) — usado para o IP real
TRUST_PROXY=1

# ---- Postgres (local: docker compose; produção: Neon com DATABASE_SSL=true) ----
DATABASE_URL=postgres://turbo:turbo_dev_password@localhost:5432/turbo_mais
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---- Redis (local: docker compose; produção: Upstash rediss://...) ----
REDIS_URL=redis://localhost:6379

# ---- Segredos (mín. 32 caracteres, UM POR FINALIDADE) ----
JWT_ACCESS_SECRET=troque-este-segredo-de-access-por-um-aleatorio-de-48-bytes
JWT_RESET_SECRET=troque-este-segredo-de-reset-por-um-aleatorio-de-48-bytes
JWT_2FA_SECRET=troque-este-segredo-de-2fa-por-um-aleatorio-de-48-bytes!!
CODE_HMAC_SECRET=troque-este-pepper-hmac-por-um-aleatorio-de-48-bytes!!!!
JWT_ISSUER=turbo-mais-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12

# ---- Web ----
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_URL=http://localhost:5173
# true em produção (HTTPS). Obrigatório: a API recusa subir em produção sem isso.
COOKIE_SECURE=false

# ---- E-mail: Resend (principal) → SMTP/Nodemailer (fallback) → console (só dev) ----
EMAIL_FROM=Turbo Mais <nao-responda@turbomais.dev>
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- Dados de mercado ----
# live = APIs reais (brapi, CoinGecko, Alpha Vantage) | mock = simulado determinístico
MARKET_DATA_MODE=live
# Só DEV: se a API real falhar e não houver cache, mostra dado simulado (marcado)
MARKET_DATA_FALLBACK_SIMULADO=false
BRAPI_TOKEN=
ALPHA_VANTAGE_API_KEY=
COINGECKO_API_KEY=
CACHE_TTL_SECONDS=60
CACHE_STALE_SECONDS=600

# ---- Workers ----
PRICE_WATCH_INTERVAL_MS=60000
# true = workers rodam DENTRO do processo da API (plano gratuito sem background
# worker). Em produção com escala, deixe false e rode `node src/worker.js` à parte.
RUN_WORKERS_IN_PROCESS=false
# Janela de deduplicação de notificações (1 por alerta+direção a cada N minutos)
ALERTA_JANELA_MINUTOS=60

# ---- Operação ----
RATE_LIMIT_ENABLED=true
SWAGGER_ENABLED=true
# Se definido, /metrics exige "Authorization: Bearer <token>"
METRICS_TOKEN=

# ---- Seed (npm run db:seed) ----
SEED_DEMO_USER=true
DEMO_USER_EMAIL=demo@turbomais.dev
DEMO_USER_PASSWORD=Demo@12345
