{
  "name": "turbo-mais-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Turbo Mais — API do painel de consulta e monitoramento de mercado (Clean Architecture)",
  "main": "src/server.js",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "lint": "eslint .",
    "test": "jest --selectProjects unit",
    "test:unit": "jest --selectProjects unit --coverage",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:contract": "jest --selectProjects contract",
    "test:contract:live": "cross-env CONTRACT_LIVE=true jest --selectProjects contract",
    "test:load": "k6 run tests/load/load-test.js",
    "db:migrate": "prisma migrate deploy --schema ../database/schema.prisma",
    "db:seed": "node scripts/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "opossum": "^8.4.0",
    "p-retry": "^4.6.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.2.0",
    "resend": "^4.1.1",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "xss": "^1.0.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  }
}
