# Turbo Mais — Frontend (variáveis lidas em BUILD time pelo Vite; são públicas!)
# Nunca coloque segredos aqui: tudo com prefixo VITE_ vai parar no JavaScript do navegador.

# Vazio = mesma origem (recomendado): proxy do Vite em dev, Nginx no Docker,
# rewrite do Render em produção. Só preencha se a API estiver em outro domínio.
VITE_API_URL=

# WebSocket: no Render, o rewrite do site estático não faz upgrade de conexão,
# então aponte direto para a API (ex.: https://turbo-mais-api.onrender.com).
# A API autentica o socket via token no handshake, não por cookie.
VITE_SOCKET_URL=
