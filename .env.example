# =============================================================================
# Turbo Mais — variáveis do docker-compose (raiz). Tudo é OPCIONAL: sem este
# arquivo o compose sobe com valores de desenvolvimento e dados simulados.
# Copie para .env para customizar. NUNCA commite o .env.
#
# Variáveis da API em detalhe: backend/.env.example
# Variáveis do front: frontend/.env.example
# =============================================================================

# Senha do Postgres local
POSTGRES_PASSWORD=turbo_dev_password

# mock = dados simulados determinísticos (padrão, sem chaves)
# live = APIs reais (brapi, CoinGecko, Alpha Vantage) — preencha as chaves abaixo
MARKET_DATA_MODE=mock
MARKET_DATA_FALLBACK_SIMULADO=true
BRAPI_TOKEN=
ALPHA_VANTAGE_API_KEY=
COINGECKO_API_KEY=

# E-mail real (opcional). Sem chave, os e-mails caem no Mailpit: http://localhost:8025
RESEND_API_KEY=

# Segredos de DEV (o compose tem defaults). Em produção, gere valores aleatórios:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_RESET_SECRET=
JWT_2FA_SECRET=
CODE_HMAC_SECRET=

LOG_LEVEL=info
